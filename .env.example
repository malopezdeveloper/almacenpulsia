DJANGO_SECRET_KEY=CAMBIAR_EN_INSTALACION
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=almacen,pizarra,localhost,127.0.0.1,192.168.1.110
DJANGO_CSRF_TRUSTED_ORIGINS=https://almacen,https://pizarra,https://127.0.0.1,https://192.168.1.110
DJANGO_HTTPS=true
DATABASE_URL=postgresql://pulsia:CAMBIAR_PASSWORD@127.0.0.1:5432/pulsia_almacen
INVENTORY_BIND=127.0.0.1
INVENTORY_PORT=8080

# Integracion de red opcional. DNS publica el nombre; DHCP realiza la reserva.
# Por seguridad se conserva DHCP. Solo usar 1 si se desea una IP estática local.
PULSIA_CONFIGURE_STATIC_IP=0
PULSIA_DNS_HOST=almacen
PULSIA_DNS_SERVER=
PULSIA_DNS_ZONE=
PULSIA_DNS_TSIG_KEY_FILE=
PULSIA_DHCP_RESERVATION_URL=
PULSIA_DHCP_API_TOKEN=
